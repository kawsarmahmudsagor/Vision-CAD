# OpenAI — used for tool-calling (agent call)
OPENAI_API_KEY=sk-your-openai-key-here

# Ollama — vision (when provider="ollama") + code generation (always)
OLLAMA_BASE_URL=http://localhost:11434
VISION_MODEL=qwen3-vl:8b
CODE_MODEL=qwen3-vl:8b

# Output directory for generated .scad files
OUTPUT_DIR=outputs

# ── Local HuggingFace vision (when provider="huggingface") ───────────────────
# No API token needed — the model runs entirely on your machine via transformers.
#
# Set to a Hub model ID to download automatically on first run:
#   HF_VISION_MODEL=llava-hf/llava-1.5-7b-hf
#   HF_VISION_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct
#   HF_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct
#
# Or point to a local path if you've already downloaded the weights:
#   HF_VISION_MODEL=./models/llava-1.5-7b-hf
HF_VISION_MODEL=llava-hf/llava-1.5-7b-hf

# Maximum tokens the vision model may generate for the image description.
# Increase if descriptions are being cut off.
HF_MAX_NEW_TOKENS=1024